{
  "name": "mwu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MWU personal finance desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build:backend && npm run rebuild:native && concurrently -k \"npm:dev:frontend\" \"npm:dev:electron\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "cross-env VITE_MWU_API_ENDPOINT=http://localhost:4000/api npm --prefix frontend run build",
    "rebuild:native": "electron-rebuild --force --which-module sqlite3 --module-dir backend",
    "package:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.9.1",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mwu.desktop",
    "productName": "MWU Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "MWU-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
